# ============================================================
# K8s AI Analyzer — Environment Configuration
# Copy this file to .env and fill in your real values
# ============================================================

# ------------------------------------------------------------------
# Groq API — get your key from https://console.groq.com/
# ------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# Model to use. Recommended fast options:
#   llama3-70b-8192       (best quality)
#   llama3-8b-8192        (fastest, good for demos)
#   mixtral-8x7b-32768    (good reasoning)
GROQ_MODEL=llama3-70b-8192

# ------------------------------------------------------------------
# Backend server settings
# ------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# How often (in seconds) the K8s poller refreshes metrics
POLL_INTERVAL_SECONDS=15

# How often (in seconds) the AI agents run a full analysis pass
AI_ANALYSIS_INTERVAL_SECONDS=60

# ------------------------------------------------------------------
# Kubernetes settings
# If running inside a cluster pod, leave KUBECONFIG blank
# If running outside (on the VM directly), set to your kubeconfig path
# ------------------------------------------------------------------
KUBECONFIG=/root/.kube/config

# Comma-separated namespaces to watch. Use * for all.
WATCHED_NAMESPACES=production,monitoring,data-processing,storage,dev

# ------------------------------------------------------------------
# Frontend settings
# ------------------------------------------------------------------
BACKEND_URL=http://localhost:8000
